        <!-- ════════════════════════════════════════════════════════════ -->
        <!-- SYSTEM IN SCOPE (Blue) -->
        <!-- ════════════════════════════════════════════════════════════ -->

        <mxCell id="system-mcp-hub" value="&lt;b&gt;Enterprise MCP Hub&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#FFFFFF&quot;&gt;[Software System]&lt;br&gt;&lt;br&gt;Centralized MCP gateway in AWS GovCloud&lt;br&gt;powered by Amazon Bedrock AgentCore.&lt;br&gt;Routes AI agent tool calls to vendor MCP&lt;br&gt;servers (FRED, Jira, Confluence, GitHub).&lt;br&gt;Manages auth, memory, guardrails, &amp; routing.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;arcSize=3;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="420" width="360" height="180" as="geometry" />
        </mxCell>

