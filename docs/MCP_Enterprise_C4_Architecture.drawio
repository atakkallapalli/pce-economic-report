        <!-- ════════════════════════════════════════════════════════════ -->
        <!-- PEOPLE / ACTORS -->
        <!-- ════════════════════════════════════════════════════════════ -->

        <!-- Desktop User (Analyst / Economist) -->
        <mxCell id="person-analyst" value="&lt;b&gt;Economist / Analyst&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#FFFFFF&quot;&gt;[Person]&lt;br&gt;&lt;br&gt;Uses desktop AI clients to&lt;br&gt;query economic data, project&lt;br&gt;docs, and code repos via MCP&lt;/font&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="100" width="200" height="180" as="geometry" />
        </mxCell>

        <!-- Platform Admin -->
        <mxCell id="person-admin" value="&lt;b&gt;Platform Admin&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#FFFFFF&quot;&gt;[Person]&lt;br&gt;&lt;br&gt;Manages MCP server onboarding,&lt;br&gt;security policies, Okta config,&lt;br&gt;and AgentCore infrastructure&lt;/font&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1">
