  <diagram id="c4-level3-component" name="C4 Level 3 — Component (AgentCore Gateway)">
    <mxGraphModel dx="1800" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1400" math="0" shadow="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title3" value="&lt;font style=&quot;font-size:22px&quot;&gt;&lt;b&gt;Component Diagram&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#666666&quot;&gt;C4 Level 3 — AgentCore Gateway + MCP Target internals&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="520" y="10" width="600" height="50" as="geometry" />
        </mxCell>

        <!-- ════════════════════════════════════════════════════════════ -->
        <!-- INCOMING (Top) -->
        <!-- ════════════════════════════════════════════════════════════ -->

        <mxCell id="in-agents" value="&lt;b&gt;AI Agent Clients&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#FFFFFF&quot;&gt;[External]&lt;br&gt;Desktop / Cross-Account / On-Prem&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;fontSize=10;arcSize=3;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="70" width="250" height="70" as="geometry" />
        </mxCell>

        <mxCell id="in-okta" value="&lt;b&gt;Okta OIDC Server&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#FFFFFF&quot;&gt;[External]&lt;br&gt;JWKS + Discovery&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;fontSize=10;arcSize=3;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1400" y="70" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- ════════════════════════════════════════════════════════════ -->
        <!-- GATEWAY BOUNDARY -->
        <!-- ════════════════════════════════════════════════════════════ -->

        <mxCell id="gw-boundary" value="&lt;font style=&quot;font-size:12px;color:#1B5E20&quot;&gt;&lt;b&gt;AgentCore Gateway&lt;/b&gt; [Container Boundary]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1B5E20;strokeWidth=3;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;arcSize=2;" vertex="1" parent="1">
          <mxGeometry x="80" y="190" width="1640" height="380" as="geometry" />
        </mxCell>

        <!-- Components inside Gateway -->
        <mxCell id="comp-tls" value="&lt;b&gt;TLS Termination&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#FFFFFF&quot;&gt;[Component]&lt;br&gt;&lt;br&gt;TLS 1.3 (FIPS Ciphers)&lt;br&gt;Managed Certificate&lt;br&gt;SNI-based routing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1565C0;strokeColor=#0D47A1;fontColor=#FFFFFF;fontSize=10;arcSize=5;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="260" width="180" height="110" as="geometry" />
        </mxCell>

        <mxCell id="comp-jwt" value="&lt;b&gt;CUSTOM_JWT Authorizer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#FFFFFF&quot;&gt;[Component]&lt;br&gt;&lt;br&gt;Fetches Okta JWKS keys&lt;br&gt;Validates: sig, exp, iss, aud&lt;br&gt;Checks AllowedClients list&lt;br&gt;Extracts scopes &amp; groups&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1565C0;strokeColor=#0D47A1;fontColor=#FFFFFF;fontSize=10;arcSize=5;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="260" width="200" height="130" as="geometry" />
        </mxCell>

        <mxCell id="comp-rate" value="&lt;b&gt;Rate Limiter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#FFFFFF&quot;&gt;[Component]&lt;br&gt;&lt;br&gt;Per-client throttling&lt;br&gt;Token bucket algorithm&lt;br&gt;Configurable limits&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1565C0;strokeColor=#0D47A1;fontColor=#FFFFFF;fontSize=10;arcSize=5;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="260" width="170" height="110" as="geometry" />
        </mxCell>

        <mxCell id="comp-mcp-proto" value="&lt;b&gt;MCP Protocol Handler&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#FFFFFF&quot;&gt;[Component]&lt;br&gt;&lt;br&gt;Parses MCP JSON-RPC requests&lt;br&gt;Tool discovery (list_tools)&lt;br&gt;Request/response framing&lt;br&gt;SSE streaming support&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1565C0;strokeColor=#0D47A1;fontColor=#FFFFFF;fontSize=10;arcSize=5;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="260" width="200" height="130" as="geometry" />
        </mxCell>

        <mxCell id="comp-router" value="&lt;b&gt;Target Router&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#FFFFFF&quot;&gt;[Component]&lt;br&gt;&lt;br&gt;Maps tool names to&lt;br&gt;registered GatewayTargets&lt;br&gt;Scope-based access control&lt;br&gt;Load balancing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1565C0;strokeColor=#0D47A1;fontColor=#FFFFFF;fontSize=10;arcSize=5;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1070" y="260" width="190" height="130" as="geometry" />
        </mxCell>

        <mxCell id="comp-credential" value="&lt;b&gt;Credential Provider&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#FFFFFF&quot;&gt;[Component]&lt;br&gt;&lt;br&gt;GATEWAY_IAM_ROLE&lt;br&gt;Assumes per-target&lt;br&gt;IAM Task Role&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1565C0;strokeColor=#0D47A1;fontColor=#FFFFFF;fontSize=10;arcSize=5;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1310" y="260" width="180" height="110" as="geometry" />
        </mxCell>

        <mxCell id="comp-audit" value="&lt;b&gt;Audit Logger&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#FFFFFF&quot;&gt;[Component]&lt;br&gt;Logs all requests to&lt;br&gt;CloudTrail + CloudWatch&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1565C0;strokeColor=#0D47A1;fontColor=#FFFFFF;fontSize=10;arcSize=5;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="430" width="180" height="90" as="geometry" />
        </mxCell>

        <mxCell id="comp-guardrails" value="&lt;b&gt;Guardrails Enforcement&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#FFFFFF&quot;&gt;[Component]&lt;br&gt;PII/PHI filtering on responses&lt;br&gt;Topic restriction checks&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1565C0;strokeColor=#0D47A1;fontColor=#FFFFFF;fontSize=10;arcSize=5;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="430" width="200" height="90" as="geometry" />
        </mxCell>

        <mxCell id="comp-memory-client" value="&lt;b&gt;Memory Client&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#FFFFFF&quot;&gt;[Component]&lt;br&gt;Stores/retrieves episodic&lt;br&gt;context per actor + session&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1565C0;strokeColor=#0D47A1;fontColor=#FFFFFF;fontSize=10;arcSize=5;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="430" width="180" height="90" as="geometry" />
        </mxCell>

        <!-- Gateway internal arrows -->
        <mxCell id="gi-1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#0D47A1;strokeWidth=1;" edge="1" source="comp-tls" target="comp-jwt" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="gi-2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#0D47A1;strokeWidth=1;" edge="1" source="comp-jwt" target="comp-rate" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="gi-3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#0D47A1;strokeWidth=1;" edge="1" source="comp-rate" target="comp-mcp-proto" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="gi-4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#0D47A1;strokeWidth=1;" edge="1" source="comp-mcp-proto" target="comp-router" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="gi-5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#0D47A1;strokeWidth=1;" edge="1" source="comp-router" target="comp-credential" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ════════════════════════════════════════════════════════════ -->
        <!-- TARGET BOUNDARY (FRED as example) -->
        <!-- ════════════════════════════════════════════════════════════ -->

