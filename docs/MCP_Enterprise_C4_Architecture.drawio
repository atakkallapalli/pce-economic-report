        <mxCell id="xb-5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#C62828;strokeWidth=1;dashed=1;" edge="1" source="tc-secrets" target="ext-secrets3" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="xb-5-l" value="&lt;font style=&quot;font-size:9px&quot;&gt;GetSecretValue" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#C62828;" vertex="1" connectable="0" parent="xb-5"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell>

        <mxCell id="xb-6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#AD1457;strokeWidth=1;dashed=1;" edge="1" source="comp-audit" target="ext-cw3" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="xb-6-l" value="&lt;font style=&quot;font-size:9px&quot;&gt;PutLogEvents" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#AD1457;" vertex="1" connectable="0" parent="xb-6"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell>

        <!-- ════════════════════════════════════════════════════════════ -->
        <!-- REQUEST FLOW ANNOTATION -->
        <!-- ════════════════════════════════════════════════════════════ -->

        <mxCell id="flow-note" value="&lt;b&gt;Request Flow:&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;1. Client sends MCP request (TLS 1.3)&lt;br&gt;2. JWT Authorizer validates Okta token (sig, exp, scopes)&lt;br&gt;3. Rate limiter checks per-client quotas&lt;br&gt;4. MCP Protocol Handler parses JSON-RPC method &amp; params&lt;br&gt;5. Target Router maps tool name → registered GatewayTarget&lt;br&gt;6. Credential Provider assumes target's IAM Task Role&lt;br&gt;7. Request forwarded to FRED ECS Fargate task&lt;br&gt;8. MCP SDK dispatches to tool handler (fred_browse/search/get_series)&lt;br&gt;9. FRED API Client calls api.stlouisfed.org (via NAT)&lt;br&gt;10. Response flows back through Gateway → Client&lt;br&gt;11. Guardrails filters PII before returning response&lt;br&gt;12. All steps logged to CloudWatch + CloudTrail&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F57F17;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontSize=10;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="1160" width="500" height="210" as="geometry" />
        </mxCell>

