        <!-- Title -->
        <mxCell id="title2" value="&lt;font style=&quot;font-size:22px&quot;&gt;&lt;b&gt;Container Diagram&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#666666&quot;&gt;C4 Level 2 — Enterprise MCP Hub internals (AWS GovCloud + AgentCore + Okta)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="600" y="10" width="650" height="50" as="geometry" />
        </mxCell>

        <!-- ════════════════════════════════════════════════════════════ -->
