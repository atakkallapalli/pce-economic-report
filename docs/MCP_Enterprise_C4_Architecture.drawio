        <mxCell id="xb-3-l" value="&lt;font style=&quot;font-size:9px&quot;&gt;Routes tool call&lt;br&gt;to FRED target" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#D84315;" vertex="1" connectable="0" parent="xb-3"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell>

