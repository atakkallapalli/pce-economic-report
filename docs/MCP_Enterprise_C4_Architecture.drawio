        <!-- Cross-boundary arrows -->
        <mxCell id="xb-1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#438DD5;strokeWidth=2;" edge="1" source="in-agents" target="comp-tls" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="xb-1-l" value="&lt;font style=&quot;font-size:9px&quot;&gt;MCP/HTTPS + Bearer JWT" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#438DD5;" vertex="1" connectable="0" parent="xb-1"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell>

        <mxCell id="xb-2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#999999;strokeWidth=1;dashed=1;" edge="1" source="comp-jwt" target="in-okta" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="xb-2-l" value="&lt;font style=&quot;font-size:9px&quot;&gt;Fetches JWKS&lt;br&gt;(cached)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#999999;" vertex="1" connectable="0" parent="xb-2"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell>

