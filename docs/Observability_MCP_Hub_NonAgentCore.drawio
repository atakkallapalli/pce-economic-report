        <!-- Component: HTTP Transport Layer -->
        <mxCell id="comp-transport" value="&lt;b&gt;HTTP/SSE Transport Layer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#FFFFFF&quot;&gt;[Component]&lt;br&gt;&lt;br&gt;Express.js / FastAPI&lt;br&gt;HTTP POST /mcp (Streamable HTTP)&lt;br&gt;SSE for streaming responses&lt;br&gt;Health endpoint: GET /health&lt;br&gt;Request parsing &amp; validation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=10;arcSize=5;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="550" y="260" width="250" height="160" as="geometry" />
        </mxCell>

        <!-- Component: MCP Protocol Handler -->
        <mxCell id="comp-protocol" value="&lt;b&gt;MCP Protocol Handler&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#FFFFFF&quot;&gt;[Component]&lt;br&gt;&lt;br&gt;JSON-RPC 2.0 Processing&lt;br&gt;tools/list → Tool Registry&lt;br&gt;tools/call → Tool Router&lt;br&gt;initialize → Capabilities&lt;br&gt;MCP SDK (TypeScript/Python)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=10;arcSize=5;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="550" y="490" width="250" height="160" as="geometry" />
        </mxCell>

        <!-- Component: Tool Registry -->
        <mxCell id="comp-registry" value="&lt;b&gt;Tool Registry&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#FFFFFF&quot;&gt;[Component]&lt;br&gt;&lt;br&gt;Registered Tools:&lt;br&gt;  • splunk_search&lt;br&gt;  • splunk_get_alerts&lt;br&gt;  • splunk_list_indexes&lt;br&gt;  • splunk_saved_searches&lt;br&gt;JSON Schema Definitions&lt;br&gt;Input Validation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=10;arcSize=5;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="490" width="220" height="180" as="geometry" />
        </mxCell>

        <!-- Component: Vendor API Client -->
        <mxCell id="comp-client" value="&lt;b&gt;Splunk API Client&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#FFFFFF&quot;&gt;[Component]&lt;br&gt;&lt;br&gt;HTTP Client (axios/httpx)&lt;br&gt;Splunk REST API v2&lt;br&gt;Connection Pooling&lt;br&gt;Retry (exponential backoff)&lt;br&gt;Timeout: 30s&lt;br&gt;Response Parsing (JSON/XML)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=10;arcSize=5;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="550" y="740" width="250" height="170" as="geometry" />
        </mxCell>

        <!-- Component: Credential Provider -->
        <mxCell id="comp-creds" value="&lt;b&gt;Credential Provider&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#FFFFFF&quot;&gt;[Component]&lt;br&gt;&lt;br&gt;Fetches from Secrets Manager&lt;br&gt;In-memory cache (TTL 5 min)&lt;br&gt;Lazy initialization&lt;br&gt;IAM Role for access&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=10;arcSize=5;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="770" width="220" height="140" as="geometry" />
        </mxCell>

        <!-- Component: Response Formatter -->
        <mxCell id="comp-formatter" value="&lt;b&gt;Response Formatter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#FFFFFF&quot;&gt;[Component]&lt;br&gt;&lt;br&gt;MCP tool_result formatting&lt;br&gt;Pagination handling&lt;br&gt;Error mapping&lt;br&gt;Content truncation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=10;arcSize=5;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="550" y="980" width="220" height="140" as="geometry" />
        </mxCell>

        <!-- Component: Observability -->
        <mxCell id="comp-obs" value="&lt;b&gt;Observability Middleware&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#FFFFFF&quot;&gt;[Component]&lt;br&gt;&lt;br&gt;Structured Logging (JSON)&lt;br&gt;X-Ray Trace Segments&lt;br&gt;Custom Metrics (EMF)&lt;br&gt;Request/Response Logging&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=10;arcSize=5;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="370" y="490" width="140" height="160" as="geometry" />
