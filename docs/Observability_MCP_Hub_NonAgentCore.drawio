        <!-- ════════════════════════════════════════════ -->
        <!-- MCP SERVER CONTAINER BOUNDARY -->
        <!-- ════════════════════════════════════════════ -->

        <mxCell id="server-boundary" value="&lt;b&gt;Splunk MCP Server&lt;/b&gt; [Container: ECS Fargate Task — Port 3000]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D86613;strokeWidth=3;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontSize=12;fontColor=#D86613;fontStyle=1;arcSize=2;" vertex="1" parent="1">
