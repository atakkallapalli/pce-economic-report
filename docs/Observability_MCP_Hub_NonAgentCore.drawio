  <diagram id="nonac-c4-level1" name="C4 Level 1 — System Context">
    <mxGraphModel dx="1900" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1300" math="0" shadow="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="&lt;font style=&quot;font-size:22px&quot;&gt;&lt;b&gt;System Context Diagram&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#666666&quot;&gt;C4 Level 1 — Enterprise Observability MCP Hub (Non-AgentCore) | AWS GovCloud + Okta OIDC + IAM&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#999999&quot;&gt;Network components (TGW, VPN, PrivateLink, Shield, WAF) managed by Enterprise Network Team — not shown&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="400" y="10" width="750" height="65" as="geometry" />
        </mxCell>

        <!-- ════════════════════════════════════════════ -->
        <!-- PEOPLE -->
        <!-- ════════════════════════════════════════════ -->

        <mxCell id="person-sre" value="&lt;b&gt;SRE / Platform Engineer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#FFFFFF&quot;&gt;[Person]&lt;br&gt;&lt;br&gt;Uses AI coding agents to&lt;br&gt;investigate incidents, query&lt;br&gt;logs/metrics, and automate&lt;br&gt;operational runbooks&lt;/font&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="80" width="200" height="180" as="geometry" />
        </mxCell>

        <mxCell id="person-admin" value="&lt;b&gt;Observability Admin&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#FFFFFF&quot;&gt;[Person]&lt;br&gt;&lt;br&gt;Manages MCP server configs,&lt;br&gt;Okta scopes, IAM policies,&lt;br&gt;and vendor integrations&lt;/font&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1600" y="80" width="200" height="180" as="geometry" />
        </mxCell>

        <!-- ════════════════════════════════════════════ -->
        <!-- SYSTEM IN SCOPE (Blue) -->
        <!-- ════════════════════════════════════════════ -->

        <mxCell id="system-obs-hub" value="&lt;b&gt;Enterprise Observability MCP Hub&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#FFFFFF&quot;&gt;[Software System]&lt;br&gt;&lt;br&gt;Centralized observability gateway in AWS&lt;br&gt;GovCloud. ECS Fargate hosting self-hosted&lt;br&gt;vendor MCP servers for Splunk, Dynatrace,&lt;br&gt;S3 Lakehouse, and CloudWatch.&lt;br&gt;API Gateway + Okta OIDC JWT auth.&lt;br&gt;Provides unified MCP tool access for&lt;br&gt;AI agents across the enterprise.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;arcSize=3;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="400" width="400" height="220" as="geometry" />
        </mxCell>
        <!-- AWS Cloud Icon next to system-in-scope box -->
        <mxCell id="aws-icon" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.general_AWS_cloud;" vertex="1" parent="1">
          <mxGeometry x="985" y="405" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- ════════════════════════════════════════════ -->
        <!-- MCP CLIENT SYSTEMS -->
        <!-- ════════════════════════════════════════════ -->

        <mxCell id="sys-desktop" value="&lt;b&gt;Desktop AI Coding Agents&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#FFFFFF&quot;&gt;[Software System]&lt;br&gt;&lt;br&gt;Claude Desktop, Cursor, VS Code&lt;br&gt;Copilot, Kiro, Devin — MCP clients&lt;br&gt;used for incident investigation&lt;br&gt;and operational automation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;fontSize=11;arcSize=3;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="380" width="260" height="150" as="geometry" />
        </mxCell>

        <mxCell id="sys-cloud-apps" value="&lt;b&gt;Enterprise Cloud Application Agents&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#FFFFFF&quot;&gt;[Software System]&lt;br&gt;&lt;br&gt;Apps deployed in enterprise AWS&lt;br&gt;accounts (ECS, Lambda, SageMaker)&lt;br&gt;using MCP client SDKs for&lt;br&gt;automated remediation &amp; analysis&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;fontSize=11;arcSize=3;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="600" width="270" height="150" as="geometry" />
        </mxCell>

        <mxCell id="sys-onprem-agents" value="&lt;b&gt;On-Premises Ops Agents&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#FFFFFF&quot;&gt;[Software System]&lt;br&gt;&lt;br&gt;Autonomous incident response&lt;br&gt;agents on datacenter servers.&lt;br&gt;Python SDK + Bedrock LLMs.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;fontSize=11;arcSize=3;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="370" y="130" width="230" height="130" as="geometry" />
        </mxCell>

        <!-- ════════════════════════════════════════════ -->
        <!-- EXTERNAL: IdP (Okta) -->
        <!-- ════════════════════════════════════════════ -->

        <mxCell id="ext-okta" value="&lt;b&gt;Okta Identity Provider&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#FFFFFF&quot;&gt;[External System]&lt;br&gt;&lt;br&gt;Enterprise IdP.&lt;br&gt;OIDC / OAuth 2.0 Authorization Server.&lt;br&gt;Issues JWT access tokens (RS256).&lt;br&gt;Adaptive MFA &amp; Group-based scopes.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;fontSize=11;arcSize=3;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1300" y="130" width="260" height="150" as="geometry" />
        </mxCell>

