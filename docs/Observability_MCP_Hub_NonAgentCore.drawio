        <!-- ════════════════════════════════════════════ -->
        <!-- COMPONENT RELATIONSHIPS -->
        <!-- ════════════════════════════════════════════ -->

        <!-- ALB → Transport -->
        <mxCell id="r3-alb-transport" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#438DD5;strokeWidth=2;" edge="1" source="ext-alb" target="comp-transport" parent="1">
