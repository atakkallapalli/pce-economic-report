        <!-- Transport → Protocol -->
        <mxCell id="r3-transport-protocol" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#438DD5;strokeWidth=2;" edge="1" source="comp-transport" target="comp-protocol" parent="1">
