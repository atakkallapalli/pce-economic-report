        <mxCell id="title3" value="&lt;font style=&quot;font-size:22px&quot;&gt;&lt;b&gt;Component Diagram&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#666666&quot;&gt;C4 Level 3 — Internal Components of a Gateway Target MCP Server (e.g., Splunk MCP on ECS Fargate)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
