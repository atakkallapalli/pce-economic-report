        <!-- ════════════════════════════════════════════ -->
        <!-- COMPONENT RELATIONSHIPS -->
        <!-- ════════════════════════════════════════════ -->

        <mxCell id="r3-gw-transport" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#438DD5;strokeWidth=2;" edge="1" source="ext-gw" target="comp-transport" parent="1">
