        <mxCell id="ent-boundary" value="&lt;b&gt;Enterprise Cloud Network Boundary&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#555&quot;&gt;Accessible via internal APIs (enterprise network routing)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#555555;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=top;align=center;spacingTop=5;fontSize=11;fontColor=#555555;" vertex="1" parent="1">
