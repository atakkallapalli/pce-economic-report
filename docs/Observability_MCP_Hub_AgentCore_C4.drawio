        <mxCell id="r3-gw-transport-l" value="&lt;font style=&quot;font-size:8px&quot;&gt;HTTP :3000" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#438DD5;" vertex="1" connectable="0" parent="r3-gw-transport">
