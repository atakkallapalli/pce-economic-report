          <mxGeometry x="80" y="750" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- ════════════════════════════════════════════ -->
        <!-- MCP SERVER CONTAINER BOUNDARY -->
        <!-- ════════════════════════════════════════════ -->

        <mxCell id="server-boundary" value="&lt;b&gt;Splunk MCP Server&lt;/b&gt; [Container: ECS Fargate Task — Port 3000 — GatewayTarget: splunk-mcp-target]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D86613;strokeWidth=3;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontSize=12;fontColor=#D86613;fontStyle=1;arcSize=2;" vertex="1" parent="1">
          <mxGeometry x="320" y="180" width="1050" height="1000" as="geometry" />
        </mxCell>

        <!-- Component: HTTP Transport Layer -->
        <mxCell id="comp-transport" value="&lt;b&gt;HTTP/SSE Transport Layer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#FFFFFF&quot;&gt;[Component]&lt;br&gt;&lt;br&gt;Express.js / FastAPI&lt;br&gt;HTTP POST /mcp (Streamable HTTP)&lt;br&gt;SSE for streaming responses&lt;br&gt;Health endpoint: GET /health&lt;br&gt;Request parsing &amp; validation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=10;arcSize=5;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="550" y="240" width="250" height="160" as="geometry" />
