        <mxCell id="sys-govcloud-apps" value="&lt;b&gt;GovCloud Application Agents&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#FFFFFF&quot;&gt;[Software System]&lt;br&gt;&lt;br&gt;Apps deployed in AWS GovCloud&lt;br&gt;(ECS, Lambda, SageMaker)&lt;br&gt;running AgentCore Runtime&lt;br&gt;for automated remediation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;fontSize=11;arcSize=3;shadow=1;" vertex="1" parent="1">
