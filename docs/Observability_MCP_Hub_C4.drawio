        <mxCell id="x3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#C62828;strokeWidth=1;dashed=1;" edge="1" source="comp-secrets" target="ext-secrets" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="x3-l" value="&lt;font style=&quot;font-size:9px&quot;&gt;GetSecretValue" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#C62828;" vertex="1" connectable="0" parent="x3"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell>

        <mxCell id="x4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#AD1457;strokeWidth=1;dashed=1;" edge="1" source="comp-healthcheck" target="ext-cw" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="x4-l" value="&lt;font style=&quot;font-size:9px&quot;&gt;Logs &amp; Metrics" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#AD1457;" vertex="1" connectable="0" parent="x4"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell>

        <!-- Request Flow -->
        <mxCell id="flow-note" value="&lt;b&gt;Request Flow (splunk_search example):&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;1. AgentCore Gateway routes MCP tool call to Splunk target (port 3000)&lt;br&gt;2. MCP SDK parses JSON-RPC request, dispatches to splunk_search handler&lt;br&gt;3. splunk_search handler builds SPL query parameters&lt;br&gt;4. Splunk REST Client reads API token from Secrets Manager (cached)&lt;br&gt;5. Client POSTs to Splunk /services/search/jobs (creates async search)&lt;br&gt;6. Client polls /services/search/jobs/{sid}/results until complete&lt;br&gt;7. Response Formatter transforms Splunk JSON into MCP tool result&lt;br&gt;8. Result streamed back via MCP SDK → Gateway → AI Agent&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F57F17;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontSize=10;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="1130" width="530" height="180" as="geometry" />
        </mxCell>

