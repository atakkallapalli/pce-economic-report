  <diagram id="obs-c4-level3" name="C4 Level 3 — Component (Splunk MCP Target)">
    <mxGraphModel dx="1800" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1400" math="0" shadow="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title3" value="&lt;font style=&quot;font-size:22px&quot;&gt;&lt;b&gt;Component Diagram&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#666666&quot;&gt;C4 Level 3 — Splunk MCP Server internals (Self-Hosted on ECS Fargate)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="450" y="10" width="650" height="50" as="geometry" />
        </mxCell>

        <!-- Incoming -->
        <mxCell id="in-gw" value="&lt;b&gt;AgentCore Gateway&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#FFFFFF&quot;&gt;[Container]&lt;br&gt;Routes MCP tool calls after JWT validation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1B5E20;strokeColor=#0D3C11;fontColor=#FFFFFF;fontSize=10;arcSize=5;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="650" y="70" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="in-gw-i" value="" style="sketch=0;outlineConnect=0;fillColor=#FFFFFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;" vertex="1" parent="1">
          <mxGeometry x="915" y="75" width="28" height="28" as="geometry" />
        </mxCell>

        <!-- ════════════════════════════════════════════ -->
        <!-- SPLUNK MCP SERVER BOUNDARY -->
        <!-- ════════════════════════════════════════════ -->

        <mxCell id="splunk-boundary" value="&lt;font style=&quot;font-size:12px;color:#D84315&quot;&gt;&lt;b&gt;Splunk MCP Server&lt;/b&gt; [Container Boundary — ECS Fargate Task, Port 3000]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D84315;strokeWidth=3;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;arcSize=2;" vertex="1" parent="1">
          <mxGeometry x="50" y="200" width="1700" height="700" as="geometry" />
        </mxCell>

        <!-- MCP SDK -->
        <mxCell id="comp-sdk" value="&lt;b&gt;MCP Server SDK&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#FFFFFF&quot;&gt;[Component: MCP Protocol Layer]&lt;br&gt;&lt;br&gt;Handles JSON-RPC framing&lt;br&gt;Tool registration &amp; dispatch&lt;br&gt;HTTP/SSE transport&lt;br&gt;Streaming responses&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D84315;strokeColor=#BF360C;fontColor=#FFFFFF;fontSize=10;arcSize=5;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="280" width="230" height="130" as="geometry" />
        </mxCell>

        <!-- Tool Handlers -->
        <mxCell id="comp-search" value="&lt;b&gt;splunk_search&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#FFFFFF&quot;&gt;[Component: Tool Handler]&lt;br&gt;&lt;br&gt;Executes SPL queries&lt;br&gt;against Splunk indexes.&lt;br&gt;Supports real-time &amp;&lt;br&gt;historical searches.&lt;br&gt;Pagination support.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E65100;strokeColor=#BF360C;fontColor=#FFFFFF;fontSize=10;arcSize=5;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="270" width="200" height="150" as="geometry" />
        </mxCell>

        <mxCell id="comp-alerts" value="&lt;b&gt;splunk_get_alerts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#FFFFFF&quot;&gt;[Component: Tool Handler]&lt;br&gt;&lt;br&gt;Lists fired/triggered alerts.&lt;br&gt;Filters by severity, time&lt;br&gt;window, and alert action.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E65100;strokeColor=#BF360C;fontColor=#FFFFFF;fontSize=10;arcSize=5;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="630" y="270" width="200" height="140" as="geometry" />
        </mxCell>

        <mxCell id="comp-saved" value="&lt;b&gt;splunk_saved_searches&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#FFFFFF&quot;&gt;[Component: Tool Handler]&lt;br&gt;&lt;br&gt;Lists and runs saved&lt;br&gt;searches/reports.&lt;br&gt;Returns cached results.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E65100;strokeColor=#BF360C;fontColor=#FFFFFF;fontSize=10;arcSize=5;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="270" width="200" height="140" as="geometry" />
        </mxCell>

        <mxCell id="comp-events" value="&lt;b&gt;splunk_get_events&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#FFFFFF&quot;&gt;[Component: Tool Handler]&lt;br&gt;&lt;br&gt;Retrieves raw events by&lt;br&gt;index, source, sourcetype.&lt;br&gt;Time-range filtering.&lt;br&gt;Field extraction.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E65100;strokeColor=#BF360C;fontColor=#FFFFFF;fontSize=10;arcSize=5;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1130" y="270" width="200" height="150" as="geometry" />
        </mxCell>

        <mxCell id="comp-health" value="&lt;b&gt;splunk_cluster_health&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#FFFFFF&quot;&gt;[Component: Tool Handler]&lt;br&gt;&lt;br&gt;Cluster replication status&lt;br&gt;Index health, license usage.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E65100;strokeColor=#BF360C;fontColor=#FFFFFF;fontSize=10;arcSize=5;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1380" y="270" width="200" height="130" as="geometry" />
        </mxCell>

        <!-- Splunk REST Client -->
        <mxCell id="comp-rest" value="&lt;b&gt;Splunk REST API Client&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#FFFFFF&quot;&gt;[Component: HTTP Client]&lt;br&gt;&lt;br&gt;Builds Splunk REST API URLs&lt;br&gt;Manages session auth tokens&lt;br&gt;Handles async job polling&lt;br&gt;(search/jobs/{sid}/results)&lt;br&gt;Connection pooling &amp; retry&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D84315;strokeColor=#BF360C;fontColor=#FFFFFF;fontSize=10;arcSize=5;shadow=1;" vertex="1" parent="1">
