        <!-- Title -->
        <mxCell id="title" value="&lt;font style=&quot;font-size:22px&quot;&gt;&lt;b&gt;System Context Diagram&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#666666&quot;&gt;C4 Level 1 — Enterprise Observability MCP Hub (AWS GovCloud + AgentCore + Okta)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="470" y="15" width="680" height="55" as="geometry" />
        </mxCell>

        <!-- ════════════════════════════════════════════ -->
        <!-- PEOPLE -->
        <!-- ════════════════════════════════════════════ -->

        <mxCell id="person-sre" value="&lt;b&gt;SRE / Platform Engineer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#FFFFFF&quot;&gt;[Person]&lt;br&gt;&lt;br&gt;Uses AI coding agents to&lt;br&gt;investigate incidents, query&lt;br&gt;logs/metrics, and automate&lt;br&gt;operational runbooks&lt;/font&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="80" width="200" height="180" as="geometry" />
        </mxCell>

        <mxCell id="person-admin" value="&lt;b&gt;Observability Admin&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#FFFFFF&quot;&gt;[Person]&lt;br&gt;&lt;br&gt;Manages MCP server targets,&lt;br&gt;Okta scopes, AgentCore config,&lt;br&gt;and vendor integrations&lt;/font&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1600" y="80" width="200" height="180" as="geometry" />
        </mxCell>

        <!-- ════════════════════════════════════════════ -->
        <!-- SYSTEM IN SCOPE (Blue) -->
        <!-- ════════════════════════════════════════════ -->

        <mxCell id="system-obs-hub" value="&lt;b&gt;Enterprise Observability MCP Hub&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#FFFFFF&quot;&gt;[Software System]&lt;br&gt;&lt;br&gt;Centralized observability gateway in AWS&lt;br&gt;GovCloud powered by Bedrock AgentCore.&lt;br&gt;Hosts self-hosted vendor MCP servers for&lt;br&gt;Splunk, Dynatrace, S3 Lakehouse, and&lt;br&gt;CloudWatch. Provides unified tool access&lt;br&gt;for AI agents across the enterprise.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;arcSize=3;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="420" width="380" height="200" as="geometry" />
        </mxCell>
        <mxCell id="aws-icon" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.general_AWS_cloud;" vertex="1" parent="1">
          <mxGeometry x="975" y="425" width="35" height="35" as="geometry" />
        </mxCell>

        <!-- ════════════════════════════════════════════ -->
        <!-- AI AGENT CLIENT SYSTEMS -->
        <!-- ════════════════════════════════════════════ -->

        <mxCell id="sys-desktop" value="&lt;b&gt;Desktop AI Coding Agents&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#FFFFFF&quot;&gt;[Software System]&lt;br&gt;&lt;br&gt;Claude Desktop, Cursor, VS Code&lt;br&gt;Copilot, Devin — MCP clients&lt;br&gt;used for incident investigation&lt;br&gt;and operational automation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;fontSize=11;arcSize=3;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="380" width="250" height="150" as="geometry" />
