        <mxCell id="a-govcloud" value="&lt;b&gt;GovCloud Application Agents&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#FFFFFF&quot;&gt;[External] ECS/Lambda in other accounts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;fontSize=10;arcSize=3;shadow=1;" vertex="1" parent="1">
