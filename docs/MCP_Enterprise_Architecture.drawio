  <diagram id="mcp-security-detail" name="2 - Security Architecture Detail">
    <mxGraphModel dx="2000" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="sec-title" value="&lt;b&gt;MCP Security Architecture — Defense in Depth&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#666&quot;&gt;Authentication, Authorization &amp; Network Segmentation Layers&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="500" y="20" width="600" height="50" as="geometry" />
        </mxCell>

        <!-- ================================================================ -->
        <!-- LAYER 1: PERIMETER -->
        <!-- ================================================================ -->

        <mxCell id="layer1" value="&lt;b&gt;Layer 1 — Perimeter Defense&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#FFEBEE;strokeColor=#C62828;verticalAlign=top;align=left;spacingLeft=15;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="1920" height="200" as="geometry" />
        </mxCell>

        <mxCell id="l1-shield" value="&lt;b&gt;AWS Shield Advanced&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• Volumetric DDoS mitigation&lt;br&gt;• L3/L4/L7 protection&lt;br&gt;• 24/7 DRT access&lt;br&gt;• Cost protection&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFCDD2;strokeColor=#E53935;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="140" width="180" height="120" as="geometry" />
        </mxCell>

        <mxCell id="l1-waf" value="&lt;b&gt;AWS WAF v2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• OWASP Top 10 managed rules&lt;br&gt;• Rate limiting (1000 req/min)&lt;br&gt;• IP allowlisting (corp ranges)&lt;br&gt;• Geo-restriction (US-only)&lt;br&gt;• SQL injection / XSS blocking&lt;br&gt;• Bot control rules&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFCDD2;strokeColor=#E53935;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="300" y="140" width="200" height="120" as="geometry" />
        </mxCell>

        <mxCell id="l1-acm" value="&lt;b&gt;ACM + TLS 1.3&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• Managed certificates&lt;br&gt;• Auto-renewal&lt;br&gt;• FIPS-compliant endpoints&lt;br&gt;• Perfect Forward Secrecy&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFCDD2;strokeColor=#E53935;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="540" y="140" width="180" height="120" as="geometry" />
        </mxCell>

        <mxCell id="l1-geo" value="&lt;b&gt;GovCloud Isolation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• Physically isolated regions&lt;br&gt;• US-person operated&lt;br&gt;• FedRAMP High baseline&lt;br&gt;• ITAR / EAR compliant&lt;br&gt;• DoD SRG IL4/IL5&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFCDD2;strokeColor=#E53935;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="760" y="140" width="180" height="120" as="geometry" />
        </mxCell>

        <!-- ================================================================ -->
        <!-- LAYER 2: AUTHENTICATION -->
        <!-- ================================================================ -->

        <mxCell id="layer2" value="&lt;b&gt;Layer 2 — Authentication&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#E8F5E9;strokeColor=#2E7D32;verticalAlign=top;align=left;spacingLeft=15;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="1920" height="220" as="geometry" />
        </mxCell>

        <mxCell id="l2-cognito" value="&lt;b&gt;Amazon Cognito&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• SAML 2.0 / OIDC federation&lt;br&gt;• Client Credentials Grant (M2M)&lt;br&gt;• Custom scopes per MCP service&lt;br&gt;  - fred:read, fred:search&lt;br&gt;  - jira:read, jira:write&lt;br&gt;  - confluence:read&lt;br&gt;• JWT token issuance (15min TTL)&lt;br&gt;• Refresh token rotation&lt;br&gt;• MFA (TOTP) enforced&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#C8E6C9;strokeColor=#43A047;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="370" width="220" height="150" as="geometry" />
        </mxCell>

        <mxCell id="l2-mtls" value="&lt;b&gt;Mutual TLS (mTLS)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• Client certificate validation&lt;br&gt;• API Gateway mTLS config&lt;br&gt;• Truststore in S3&lt;br&gt;• Certificate pinning for M2M&lt;br&gt;• Per-account client certs&lt;br&gt;• Cert revocation via CRL&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#C8E6C9;strokeColor=#43A047;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="340" y="370" width="200" height="150" as="geometry" />
        </mxCell>

        <mxCell id="l2-apikeys" value="&lt;b&gt;API Key Management&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• Usage plans per consumer tier&lt;br&gt;• Throttle: 100 req/sec burst&lt;br&gt;• Quota: 10K req/day (default)&lt;br&gt;• Keys rotated via Secrets Mgr&lt;br&gt;• Keys are identifiers, not auth&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#C8E6C9;strokeColor=#43A047;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="580" y="370" width="200" height="150" as="geometry" />
        </mxCell>

        <mxCell id="l2-iam" value="&lt;b&gt;IAM Authentication&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• SigV4 for cross-account calls&lt;br&gt;• AssumeRole with ExternalId&lt;br&gt;• Session tags for ABAC&lt;br&gt;• Temporary credentials only&lt;br&gt;• No long-lived access keys&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#C8E6C9;strokeColor=#43A047;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="820" y="370" width="200" height="150" as="geometry" />
        </mxCell>

        <!-- ================================================================ -->
        <!-- LAYER 3: AUTHORIZATION -->
        <!-- ================================================================ -->

        <mxCell id="layer3" value="&lt;b&gt;Layer 3 — Authorization&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#E3F2FD;strokeColor=#1565C0;verticalAlign=top;align=left;spacingLeft=15;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="570" width="1920" height="220" as="geometry" />
        </mxCell>

        <mxCell id="l3-rbac" value="&lt;b&gt;RBAC via Cognito Groups&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• Groups: admin, analyst, reader&lt;br&gt;• Group → IAM role mapping&lt;br&gt;• Group claims in JWT&lt;br&gt;• API GW checks group scope&lt;br&gt;• Deny-by-default policy&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#BBDEFB;strokeColor=#1976D2;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="620" width="200" height="150" as="geometry" />
        </mxCell>

        <mxCell id="l3-task-roles" value="&lt;b&gt;Per-Service ECS Task Roles&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• FRED MCP: SecretsManager (fred-*)&lt;br&gt;• Jira MCP: SecretsManager (jira-*)&lt;br&gt;• Each task role scoped to&lt;br&gt;  only its own vendor secrets&lt;br&gt;• No shared roles across services&lt;br&gt;• Condition keys on tags&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#BBDEFB;strokeColor=#1976D2;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="320" y="620" width="220" height="150" as="geometry" />
        </mxCell>

        <mxCell id="l3-resource-pol" value="&lt;b&gt;Resource Policies&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• VPC Endpoint policies limit&lt;br&gt;  which accounts can connect&lt;br&gt;• S3 bucket policies (VPC-only)&lt;br&gt;• KMS key policies (per-service)&lt;br&gt;• API GW resource policy&lt;br&gt;  (account + VPC allowlist)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#BBDEFB;strokeColor=#1976D2;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="580" y="620" width="220" height="150" as="geometry" />
        </mxCell>

        <mxCell id="l3-scp" value="&lt;b&gt;Service Control Policies&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• Deny non-GovCloud regions&lt;br&gt;• Deny public S3 / ECR&lt;br&gt;• Require KMS encryption&lt;br&gt;• Enforce mandatory tagging&lt;br&gt;• Deny root user actions&lt;br&gt;• Deny disabling CloudTrail&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#BBDEFB;strokeColor=#1976D2;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="840" y="620" width="200" height="150" as="geometry" />
        </mxCell>

        <!-- ================================================================ -->
        <!-- LAYER 4: NETWORK SEGMENTATION -->
        <!-- ================================================================ -->

        <mxCell id="layer4" value="&lt;b&gt;Layer 4 — Network Segmentation&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#FFF3E0;strokeColor=#E65100;verticalAlign=top;align=left;spacingLeft=15;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="820" width="1920" height="220" as="geometry" />
        </mxCell>

        <mxCell id="l4-vpc" value="&lt;b&gt;VPC Isolation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• Dedicated MCP VPC (10.0.0.0/16)&lt;br&gt;• Public subnets: ALB/NLB only&lt;br&gt;• Private subnets: ECS tasks only&lt;br&gt;• No IGW route to private subnets&lt;br&gt;• NAT GW for outbound only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFE0B2;strokeColor=#F57C00;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="870" width="200" height="140" as="geometry" />
        </mxCell>

        <mxCell id="l4-sg" value="&lt;b&gt;Security Groups&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• ALB SG: 443 from WAF/APIGW only&lt;br&gt;• ECS SG: 3000-3010 from ALB SG&lt;br&gt;• No direct internet → ECS&lt;br&gt;• SG references (not CIDR)&lt;br&gt;• Stateful inspection&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFE0B2;strokeColor=#F57C00;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="320" y="870" width="210" height="140" as="geometry" />
        </mxCell>

        <mxCell id="l4-nacl" value="&lt;b&gt;NACLs (Stateless)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• Private subnet: deny all except&lt;br&gt;  ALB subnet CIDR on MCP ports&lt;br&gt;• Explicit deny for RFC 1918&lt;br&gt;  ranges not in use&lt;br&gt;• Ephemeral port range allowed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFE0B2;strokeColor=#F57C00;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="570" y="870" width="210" height="140" as="geometry" />
        </mxCell>

        <mxCell id="l4-privatelink" value="&lt;b&gt;AWS PrivateLink&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• Cross-account: no internet transit&lt;br&gt;• NLB → VPC Endpoint Service&lt;br&gt;• Principal allowlisting per account&lt;br&gt;• Unidirectional (consumer → provider)&lt;br&gt;• DNS private hosted zones&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFE0B2;strokeColor=#F57C00;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="820" y="870" width="220" height="140" as="geometry" />
        </mxCell>

        <!-- ================================================================ -->
        <!-- LAYER 5: DATA PROTECTION -->
        <!-- ================================================================ -->

        <mxCell id="layer5" value="&lt;b&gt;Layer 5 — Data Protection &amp; Observability&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;verticalAlign=top;align=left;spacingLeft=15;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1070" width="1920" height="220" as="geometry" />
        </mxCell>

        <mxCell id="l5-kms" value="&lt;b&gt;KMS Encryption&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• CMK (FIPS 140-2 Level 3)&lt;br&gt;• Envelope encryption everywhere&lt;br&gt;• Annual key rotation&lt;br&gt;• Per-service key aliases&lt;br&gt;• Key policy: least privilege&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#E1BEE7;strokeColor=#8E24AA;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="1120" width="200" height="140" as="geometry" />
        </mxCell>

        <mxCell id="l5-secrets" value="&lt;b&gt;Secrets Management&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• AWS Secrets Manager&lt;br&gt;• Auto-rotation (30-day cycle)&lt;br&gt;• No secrets in env vars or code&lt;br&gt;• Injected at ECS task launch&lt;br&gt;• Scoped per-service access&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#E1BEE7;strokeColor=#8E24AA;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="320" y="1120" width="200" height="140" as="geometry" />
        </mxCell>

        <mxCell id="l5-audit" value="&lt;b&gt;Audit &amp; Logging&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• CloudTrail (365d retention)&lt;br&gt;• VPC Flow Logs (90d)&lt;br&gt;• ALB Access Logs (S3)&lt;br&gt;• ECS Container Logs (CW)&lt;br&gt;• API GW Execution Logs&lt;br&gt;• Tamper-proof (S3 Object Lock)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#E1BEE7;strokeColor=#8E24AA;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="560" y="1120" width="210" height="140" as="geometry" />
        </mxCell>

        <mxCell id="l5-detect" value="&lt;b&gt;Threat Detection&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• GuardDuty (ECS runtime)&lt;br&gt;• Security Hub (NIST 800-53)&lt;br&gt;• AWS Config (drift detection)&lt;br&gt;• Inspector (CVE scanning)&lt;br&gt;• EventBridge → SNS alerts&lt;br&gt;• SOC integration via SIEM&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#E1BEE7;strokeColor=#8E24AA;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="810" y="1120" width="210" height="140" as="geometry" />
        </mxCell>

        <!-- Flow arrows between layers -->
        <mxCell id="flow-1-2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#333;strokeWidth=3;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="layer1" target="layer2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow-1-2-label" value="&lt;b&gt;Filtered Traffic&lt;/b&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#333;fontStyle=0;" vertex="1" connectable="0" parent="flow-1-2">
          <mxGeometry x="-0.2" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="flow-2-3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#333;strokeWidth=3;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="layer2" target="layer3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow-2-3-label" value="&lt;b&gt;Authenticated Identity&lt;/b&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#333;fontStyle=0;" vertex="1" connectable="0" parent="flow-2-3">
          <mxGeometry x="-0.2" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="flow-3-4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#333;strokeWidth=3;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="layer3" target="layer4" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow-3-4-label" value="&lt;b&gt;Authorized Request&lt;/b&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#333;fontStyle=0;" vertex="1" connectable="0" parent="flow-3-4">
          <mxGeometry x="-0.2" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="flow-4-5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#333;strokeWidth=3;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="layer4" target="layer5" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow-4-5-label" value="&lt;b&gt;Segmented Network Path&lt;/b&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#333;fontStyle=0;" vertex="1" connectable="0" parent="flow-4-5">
          <mxGeometry x="-0.2" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- Right-side summary: Request Flow -->
        <mxCell id="request-flow" value="&lt;b&gt;Request Flow (Desktop Client Example)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;1. Desktop AI client sends HTTPS request&lt;br&gt;&lt;br&gt;2. AWS Shield absorbs DDoS traffic&lt;br&gt;&lt;br&gt;3. WAF validates against OWASP rules,&lt;br&gt;   rate limits, and geo-restrictions&lt;br&gt;&lt;br&gt;4. API Gateway validates mTLS client cert&lt;br&gt;&lt;br&gt;5. Cognito validates OAuth 2.0 JWT token,&lt;br&gt;   checks scopes (e.g., fred:read)&lt;br&gt;&lt;br&gt;6. API Gateway checks resource policy&lt;br&gt;   (account + VPC allowlist)&lt;br&gt;&lt;br&gt;7. VPC Link routes to internal ALB&lt;br&gt;&lt;br&gt;8. ALB routes to ECS task by path&lt;br&gt;   (/fred/* → FRED MCP :3000)&lt;br&gt;&lt;br&gt;9. ECS task assumes its IAM Task Role&lt;br&gt;   to retrieve vendor secrets&lt;br&gt;&lt;br&gt;10. MCP server queries vendor API&lt;br&gt;    (outbound via NAT GW)&lt;br&gt;&lt;br&gt;11. Response returned via same path&lt;br&gt;&lt;br&gt;12. All steps logged to CloudTrail,&lt;br&gt;    CloudWatch, and VPC Flow Logs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FAFAFA;strokeColor=#333;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="1100" y="90" width="340" height="530" as="geometry" />
        </mxCell>

        <!-- Right-side: Cross-Account Flow -->
        <mxCell id="cross-account-flow" value="&lt;b&gt;Request Flow (Cross-Account Agent)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;1. Agent in Account B assumes cross-account&lt;br&gt;   IAM role with ExternalId&lt;br&gt;&lt;br&gt;2. Agent connects via VPC Interface&lt;br&gt;   Endpoint (PrivateLink — no internet)&lt;br&gt;&lt;br&gt;3. Traffic enters MCP Hub VPC via NLB&lt;br&gt;&lt;br&gt;4. NLB → ALB path-based routing&lt;br&gt;&lt;br&gt;5. ECS task processes MCP request&lt;br&gt;&lt;br&gt;6. Response returns via PrivateLink&lt;br&gt;&lt;br&gt;7. All traffic stays on AWS backbone&lt;br&gt;   (never traverses public internet)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FAFAFA;strokeColor=#333;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="1100" y="650" width="340" height="310" as="geometry" />
        </mxCell>

        <!-- Right-side: On-Prem Flow -->
        <mxCell id="onprem-flow" value="&lt;b&gt;Request Flow (On-Premises Agent)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;1. On-prem agent initiates MCP call&lt;br&gt;&lt;br&gt;2. Traffic encrypted via IPSec VPN tunnel&lt;br&gt;   (or AWS Direct Connect)&lt;br&gt;&lt;br&gt;3. Virtual Private Gateway → Transit GW&lt;br&gt;&lt;br&gt;4. Transit GW routes to MCP VPC&lt;br&gt;&lt;br&gt;5. NLB → ALB → ECS (same as above)&lt;br&gt;&lt;br&gt;6. All traffic stays on private network&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FAFAFA;strokeColor=#333;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="1100" y="990" width="340" height="270" as="geometry" />
        </mxCell>

        <!-- Right-side labels -->
        <mxCell id="conn-type-label" value="&lt;b&gt;Connectivity Patterns&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1500" y="50" width="180" height="30" as="geometry" />
        </mxCell>

        <!-- Right-side: Network connectivity summary -->
        <mxCell id="conn-summary" value="&lt;b&gt;Connectivity Matrix&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;Desktop Clients&lt;/b&gt;&lt;br&gt;→ HTTPS + OAuth + mTLS → API GW&lt;br&gt;&lt;br&gt;&lt;b&gt;Cross-Account (GovCloud)&lt;/b&gt;&lt;br&gt;→ AWS PrivateLink (preferred)&lt;br&gt;→ Transit Gateway (alternative)&lt;br&gt;&lt;br&gt;&lt;b&gt;On-Premises&lt;/b&gt;&lt;br&gt;→ Site-to-Site VPN (IPSec)&lt;br&gt;→ Direct Connect (dedicated)&lt;br&gt;&lt;br&gt;&lt;b&gt;MCP → Vendor APIs&lt;/b&gt;&lt;br&gt;→ NAT GW (outbound HTTPS only)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#E8EAF6;strokeColor=#283593;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="1500" y="90" width="300" height="310" as="geometry" />
        </mxCell>

        <!-- Tagging Strategy -->
        <mxCell id="tagging" value="&lt;b&gt;Mandatory Resource Tags&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• &lt;b&gt;env&lt;/b&gt;: prod | staging | dev&lt;br&gt;• &lt;b&gt;service&lt;/b&gt;: fred-mcp | jira-mcp | ...&lt;br&gt;• &lt;b&gt;owner&lt;/b&gt;: team-email&lt;br&gt;• &lt;b&gt;compliance&lt;/b&gt;: fedramp-high&lt;br&gt;• &lt;b&gt;data-classification&lt;/b&gt;: internal&lt;br&gt;• &lt;b&gt;cost-center&lt;/b&gt;: CC-12345&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#E8EAF6;strokeColor=#283593;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="1500" y="430" width="300" height="200" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
