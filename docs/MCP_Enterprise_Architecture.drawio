        <!-- ================================================================ -->
        <!-- LEGEND -->
        <!-- ================================================================ -->

        <mxCell id="legend-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1130" y="1400" width="1200" height="330" as="geometry" />
        </mxCell>

        <mxCell id="legend-title" value="&lt;b&gt;Legend &amp; Security Controls Summary&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1150" y="1410" width="280" height="30" as="geometry" />
        </mxCell>

        <mxCell id="legend-authn" value="&lt;b&gt;Authentication (AuthN)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• OAuth 2.0 Client Credentials (M2M) via Cognito&lt;br&gt;• SAML 2.0 / OIDC Federation for user identities&lt;br&gt;• Mutual TLS (mTLS) at API Gateway for high-trust clients&lt;br&gt;• API Keys as secondary throttle identifier&lt;br&gt;• MFA enforced for all human access&lt;br&gt;• JWT token validation on every request&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=#C62828;fillColor=#FFEBEE;fontSize=10;rounded=1;spacingLeft=5;spacingRight=5;" vertex="1" parent="1">
          <mxGeometry x="1150" y="1445" width="330" height="130" as="geometry" />
        </mxCell>

        <mxCell id="legend-authz" value="&lt;b&gt;Authorization (AuthZ)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• Per-MCP-server IAM Task Roles (least privilege)&lt;br&gt;• Cognito custom scopes per MCP service&lt;br&gt;• API Gateway resource policies (account allowlisting)&lt;br&gt;• VPC Endpoint policies restrict cross-account access&lt;br&gt;• SCPs enforce org-wide guardrails&lt;br&gt;• RBAC via Cognito groups mapped to API scopes&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=#1B5E20;fillColor=#E8F5E9;fontSize=10;rounded=1;spacingLeft=5;spacingRight=5;" vertex="1" parent="1">
          <mxGeometry x="1510" y="1445" width="330" height="130" as="geometry" />
        </mxCell>

        <mxCell id="legend-segmentation" value="&lt;b&gt;Network Segmentation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• MCP containers in private subnets (no public IPs)&lt;br&gt;• Security groups: ALB→ECS only on MCP ports&lt;br&gt;• NACLs: deny all except required flows&lt;br&gt;• PrivateLink for cross-account (no internet transit)&lt;br&gt;• Transit Gateway with isolated route tables&lt;br&gt;• Site-to-Site VPN / Direct Connect for on-prem&lt;br&gt;• NAT Gateway for outbound vendor API calls only&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=#0D47A1;fillColor=#E3F2FD;fontSize=10;rounded=1;spacingLeft=5;spacingRight=5;" vertex="1" parent="1">
          <mxGeometry x="1870" y="1445" width="330" height="145" as="geometry" />
        </mxCell>

        <mxCell id="legend-data" value="&lt;b&gt;Data Protection&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• TLS 1.3 everywhere (in-transit)&lt;br&gt;• KMS CMK encryption (at-rest) — FIPS 140-2 L3&lt;br&gt;• Secrets auto-rotated every 30 days&lt;br&gt;• No secrets in env vars — injected from Secrets Manager&lt;br&gt;• Container image signing &amp; CVE scanning&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=#E65100;fillColor=#FFF3E0;fontSize=10;rounded=1;spacingLeft=5;spacingRight=5;" vertex="1" parent="1">
          <mxGeometry x="1150" y="1585" width="350" height="115" as="geometry" />
        </mxCell>

        <mxCell id="legend-compliance" value="&lt;b&gt;Compliance &amp; Audit&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• FedRAMP High baseline (GovCloud inherent)&lt;br&gt;• NIST 800-53 automated checks via Security Hub&lt;br&gt;• CloudTrail logs all API calls (365-day retention)&lt;br&gt;• VPC Flow Logs for network forensics&lt;br&gt;• GuardDuty for runtime threat detection&lt;br&gt;• AWS Config for continuous compliance&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=#4A148C;fillColor=#F3E5F5;fontSize=10;rounded=1;spacingLeft=5;spacingRight=5;" vertex="1" parent="1">
          <mxGeometry x="1530" y="1585" width="350" height="130" as="geometry" />
        </mxCell>

