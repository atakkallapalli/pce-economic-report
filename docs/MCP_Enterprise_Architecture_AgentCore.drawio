        <mxCell id="legend-content" value="&lt;font style=&quot;font-size:9px&quot;&gt;• &lt;b&gt;AgentCore Gateway&lt;/b&gt; replaces API Gateway + ALB routing&lt;br&gt;  → Native MCP protocol support, managed TLS, built-in rate limiting&lt;br&gt;• &lt;b&gt;Okta&lt;/b&gt; replaces Cognito / Identity Center as IdP&lt;br&gt;  → CUSTOM_JWT authorizer on Gateway validates Okta JWTs&lt;br&gt;• &lt;b&gt;Gateway Targets&lt;/b&gt; replace ALB path-based routing&lt;br&gt;  → Each MCP server registered as a GatewayTarget resource&lt;br&gt;• &lt;b&gt;AgentCore Memory&lt;/b&gt; adds cross-session learning&lt;br&gt;  → Episodic, Semantic, Summary, UserPreference strategies&lt;br&gt;• &lt;b&gt;AgentCore Runtime&lt;/b&gt; manages agent container lifecycle&lt;br&gt;  → Container-based hosting with auto-scaling&lt;br&gt;• &lt;b&gt;Guardrails Engine&lt;/b&gt; adds content/governance policies&lt;br&gt;  → PII detection, topic restrictions, action governance&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="1540" width="420" height="150" as="geometry" />
        </mxCell>

        <!-- ================================================================ -->
        <!-- CONNECTIONS -->
        <!-- ================================================================ -->

        <!-- Okta → AgentCore Gateway (JWT validation) -->
        <mxCell id="conn-okta-gw" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#1A237E;strokeWidth=2;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="okta-oidc" target="ac-gateway" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conn-okta-gw-label" value="OIDC Discovery&lt;br&gt;+ JWKS Validation" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9;fontColor=#1A237E;fontStyle=1;" vertex="1" connectable="0" parent="conn-okta-gw">
          <mxGeometry x="-0.2" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- Desktop → Okta (auth) -->
        <mxCell id="conn-desktop-okta" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#1A237E;strokeWidth=2;exitX=1;exitY=0.3;exitDx=0;exitDy=0;dashed=1;" edge="1" source="desktop-zone" target="okta-oidc" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conn-desktop-okta-label" value="1. OAuth 2.0&lt;br&gt;(Auth Code + PKCE)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9;fontColor=#1A237E;fontStyle=1;" vertex="1" connectable="0" parent="conn-desktop-okta">
          <mxGeometry x="-0.3" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- Desktop → AgentCore Gateway -->
        <mxCell id="conn-desktop-gw" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#01A88D;strokeWidth=2;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="desktop-zone" target="ac-gateway" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conn-desktop-gw-label" value="2. MCP over HTTPS&lt;br&gt;+ Okta JWT Bearer" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9;fontColor=#01A88D;fontStyle=1;" vertex="1" connectable="0" parent="conn-desktop-gw">
          <mxGeometry x="-0.2" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- On-Prem → VPN -->
        <mxCell id="conn-agent1-vpn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#D86613;strokeWidth=1;" edge="1" source="onprem-agent1" target="onprem-vpn" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conn-agent2-vpn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#D86613;strokeWidth=1;" edge="1" source="onprem-agent2" target="onprem-vpn" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- On-Prem VPN → VPN Gateway -->
        <mxCell id="conn-onprem-vpn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#E65100;strokeWidth=2;" edge="1" source="onprem-vpn" target="vpn-gw" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conn-onprem-vpn-label" value="IPSec VPN" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9;fontColor=#E65100;fontStyle=1;" vertex="1" connectable="0" parent="conn-onprem-vpn">
          <mxGeometry x="-0.2" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- Other Accounts → PrivateLink -->
        <mxCell id="conn-vpce-pl" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#8C4FFF;strokeWidth=2;" edge="1" source="vpce-consumer" target="privatelink-svc" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conn-vpce-label" value="PrivateLink&lt;br&gt;(No Internet)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9;fontColor=#8C4FFF;fontStyle=1;" vertex="1" connectable="0" parent="conn-vpce-pl">
          <mxGeometry x="-0.2" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- TGW consumer → hub -->
        <mxCell id="conn-tgw-x" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#8C4FFF;strokeWidth=2;" edge="1" source="tgw-consumer" target="tgw-hub" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conn-tgw-label" value="Transit Gateway&lt;br&gt;Cross-Account" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9;fontColor=#8C4FFF;fontStyle=1;" vertex="1" connectable="0" parent="conn-tgw-x">
          <mxGeometry x="-0.2" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- Gateway → Targets -->
        <mxCell id="conn-gw-fred" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#01A88D;strokeWidth=2;" edge="1" source="ac-gateway" target="fred-target" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conn-gw-jira" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#01A88D;strokeWidth=2;" edge="1" source="ac-gateway" target="jira-target" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conn-gw-conf" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#01A88D;strokeWidth=2;" edge="1" source="ac-gateway" target="confluence-target" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conn-gw-github" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#01A88D;strokeWidth=2;" edge="1" source="ac-gateway" target="github-target" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Targets → Vendor APIs -->
        <mxCell id="conn-fred-api" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#1565C0;strokeWidth=1;dashed=1;" edge="1" source="fred-target" target="fred-api" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conn-jira-api" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#283593;strokeWidth=1;dashed=1;" edge="1" source="jira-target" target="jira-api" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conn-github-api2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#6A1B9A;strokeWidth=1;dashed=1;" edge="1" source="github-target" target="github-api" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Targets → Secrets Manager -->
        <mxCell id="conn-targets-secrets" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#DD344C;strokeWidth=1;dashed=1;" edge="1" source="fred-ecs" target="secrets-mgr" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Gateway → Memory -->
        <mxCell id="conn-gw-mem" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#3F8624;strokeWidth=1;" edge="1" source="ac-gateway" target="ac-memory" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Gateway → Guardrails -->
        <mxCell id="conn-gw-guard" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#DD344C;strokeWidth=1;" edge="1" source="ac-gateway" target="ac-guardrails" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="agentcore-security-detail" name="2 - Security &amp; Auth Flow Detail (Okta + AgentCore)">
    <mxGraphModel dx="2000" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="sec-title" value="&lt;b&gt;MCP Security Architecture — Okta IdP + AgentCore Gateway&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#666&quot;&gt;Authentication via Okta OIDC | Authorization via JWT Scopes + IAM | Network Segmentation&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="700" height="50" as="geometry" />
        </mxCell>

        <!-- ================================================================ -->
        <!-- AUTH FLOW: Desktop Client -->
        <!-- ================================================================ -->

        <mxCell id="desktop-flow" value="&lt;b&gt;Flow A — Desktop AI Client (Human User)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#E8EAF6;strokeColor=#1A237E;verticalAlign=top;align=left;spacingLeft=15;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="1920" height="230" as="geometry" />
        </mxCell>

        <mxCell id="df-step1" value="&lt;b&gt;1. User Opens MCP Client&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Claude Desktop / Cursor / VS Code&lt;br&gt;Initiates OAuth 2.0&lt;br&gt;Authorization Code + PKCE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#C5CAE9;strokeColor=#283593;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="70" y="140" width="180" height="100" as="geometry" />
        </mxCell>

        <mxCell id="df-step2" value="&lt;b&gt;2. Okta Login&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Browser redirect to Okta&lt;br&gt;Adaptive MFA (Okta Verify)&lt;br&gt;Device Trust check&lt;br&gt;Returns auth code&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#1A237E;fontColor=#FFFFFF;strokeColor=#1A237E;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="290" y="140" width="180" height="100" as="geometry" />
        </mxCell>

        <mxCell id="df-step3" value="&lt;b&gt;3. Token Exchange&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Auth code → Okta /token&lt;br&gt;Returns JWT Access Token&lt;br&gt;Claims: sub, groups, scp&lt;br&gt;Scopes: mcp:fred:read, etc.&lt;br&gt;TTL: 15 minutes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#C5CAE9;strokeColor=#283593;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="510" y="140" width="180" height="100" as="geometry" />
        </mxCell>

        <mxCell id="df-step4" value="&lt;b&gt;4. MCP Request&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Client sends MCP request&lt;br&gt;to AgentCore Gateway URL&lt;br&gt;Authorization: Bearer &lt;jwt&gt;&lt;br&gt;HTTPS / TLS 1.3&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#C5CAE9;strokeColor=#283593;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="730" y="140" width="180" height="100" as="geometry" />
        </mxCell>

        <mxCell id="df-step5" value="&lt;b&gt;5. Gateway Validates JWT&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;AgentCore CUSTOM_JWT auth&lt;br&gt;Fetches Okta JWKS keys&lt;br&gt;Validates: signature, exp,&lt;br&gt;iss, aud, allowed_clients&lt;br&gt;Checks scopes &amp; groups&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#E6F9F5;strokeColor=#01A88D;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="950" y="140" width="180" height="100" as="geometry" />
        </mxCell>

        <mxCell id="df-step6" value="&lt;b&gt;6. Route to Target&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Gateway routes MCP call&lt;br&gt;to registered GatewayTarget&lt;br&gt;(FRED/Jira/Confluence/GitHub)&lt;br&gt;Target uses IAM Role&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#E6F9F5;strokeColor=#01A88D;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="1170" y="140" width="180" height="100" as="geometry" />
        </mxCell>

        <mxCell id="df-step7" value="&lt;b&gt;7. Vendor API Call&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Target retrieves secrets&lt;br&gt;from Secrets Manager&lt;br&gt;Calls vendor API&lt;br&gt;Returns MCP response&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#C8E6C9;strokeColor=#43A047;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="1390" y="140" width="180" height="100" as="geometry" />
        </mxCell>

        <!-- Flow arrows -->
        <mxCell id="df-arr1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#333;strokeWidth=2;" edge="1" source="df-step1" target="df-step2" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="df-arr2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#333;strokeWidth=2;" edge="1" source="df-step2" target="df-step3" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="df-arr3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#333;strokeWidth=2;" edge="1" source="df-step3" target="df-step4" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="df-arr4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#333;strokeWidth=2;" edge="1" source="df-step4" target="df-step5" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="df-arr5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#333;strokeWidth=2;" edge="1" source="df-step5" target="df-step6" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="df-arr6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#333;strokeWidth=2;" edge="1" source="df-step6" target="df-step7" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ================================================================ -->
        <!-- AUTH FLOW: M2M Agent -->
        <!-- ================================================================ -->

        <mxCell id="m2m-flow" value="&lt;b&gt;Flow B — Machine-to-Machine Agent (Cross-Account / On-Prem)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#E8F5E9;strokeColor=#2E7D32;verticalAlign=top;align=left;spacingLeft=15;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="350" width="1920" height="230" as="geometry" />
        </mxCell>

        <mxCell id="m2m-step1" value="&lt;b&gt;1. Agent Starts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;ECS/Lambda/On-prem agent&lt;br&gt;reads Okta client_id +&lt;br&gt;client_secret from env&lt;br&gt;or Secrets Manager&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#C8E6C9;strokeColor=#43A047;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="70" y="400" width="180" height="100" as="geometry" />
        </mxCell>

        <mxCell id="m2m-step2" value="&lt;b&gt;2. Client Credentials Grant&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;POST to Okta /token&lt;br&gt;grant_type: client_credentials&lt;br&gt;scope: mcp:fred:read ...&lt;br&gt;Basic auth header&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#1A237E;fontColor=#FFFFFF;strokeColor=#1A237E;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="290" y="400" width="190" height="100" as="geometry" />
        </mxCell>

        <mxCell id="m2m-step3" value="&lt;b&gt;3. JWT Issued&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Okta returns JWT with:&lt;br&gt;sub: &lt;client_id&gt;&lt;br&gt;scp: [mcp:fred:read]&lt;br&gt;cid: &lt;client_id&gt;&lt;br&gt;TTL: 1 hour (configurable)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#C8E6C9;strokeColor=#43A047;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="520" y="400" width="180" height="100" as="geometry" />
        </mxCell>

        <mxCell id="m2m-step4" value="&lt;b&gt;4. MCP via PrivateLink&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Agent sends MCP request&lt;br&gt;via VPC Interface Endpoint&lt;br&gt;(PrivateLink — no internet)&lt;br&gt;Bearer: &lt;okta-jwt&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#C8E6C9;strokeColor=#43A047;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="740" y="400" width="180" height="100" as="geometry" />
        </mxCell>

        <mxCell id="m2m-step5" value="&lt;b&gt;5. Gateway Validates&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Same CUSTOM_JWT flow&lt;br&gt;Validates Okta JWT&lt;br&gt;Checks AllowedClients list&lt;br&gt;Enforces scope permissions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#E6F9F5;strokeColor=#01A88D;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="960" y="400" width="180" height="100" as="geometry" />
        </mxCell>

        <mxCell id="m2m-step6" value="&lt;b&gt;6. Route + Execute&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Gateway → Target → Vendor&lt;br&gt;Target assumes IAM Role&lt;br&gt;All traffic on AWS backbone&lt;br&gt;Logged to CloudTrail&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#E6F9F5;strokeColor=#01A88D;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="1180" y="400" width="180" height="100" as="geometry" />
        </mxCell>

        <mxCell id="m2m-arr1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#333;strokeWidth=2;" edge="1" source="m2m-step1" target="m2m-step2" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="m2m-arr2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#333;strokeWidth=2;" edge="1" source="m2m-step2" target="m2m-step3" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="m2m-arr3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#333;strokeWidth=2;" edge="1" source="m2m-step3" target="m2m-step4" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="m2m-arr4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#333;strokeWidth=2;" edge="1" source="m2m-step4" target="m2m-step5" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="m2m-arr5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#333;strokeWidth=2;" edge="1" source="m2m-step5" target="m2m-step6" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ================================================================ -->
        <!-- AGENTCORE GATEWAY JWT CONFIG -->
        <!-- ================================================================ -->

        <mxCell id="jwt-config" value="&lt;b&gt;AgentCore Gateway — Okta JWT Configuration&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#FFF4E6;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=15;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="610" width="900" height="350" as="geometry" />
        </mxCell>

        <mxCell id="jwt-gateway-cfg" value="&lt;b&gt;Gateway Resource (Terraform / CloudFormation)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;font-family:monospace&quot;&gt;Resource: AWS::BedrockAgentCore::Gateway&lt;br&gt;Properties:&lt;br&gt;  Name: mcp-hub-Gateway&lt;br&gt;  ProtocolType: MCP&lt;br&gt;  AuthorizerType: CUSTOM_JWT&lt;br&gt;  AuthorizerConfiguration:&lt;br&gt;    CustomJWTAuthorizer:&lt;br&gt;      DiscoveryUrl: https://&lt;org&gt;.okta.com&lt;br&gt;        /oauth2/&lt;auth-server-id&gt;&lt;br&gt;        /.well-known/openid-configuration&lt;br&gt;      AllowedClients:&lt;br&gt;        - &lt;okta-app-client-id-desktop&gt;&lt;br&gt;        - &lt;okta-app-client-id-m2m-agents&gt;&lt;br&gt;        - &lt;okta-app-client-id-research&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF8E1;strokeColor=#F57F17;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="660" width="400" height="280" as="geometry" />
        </mxCell>

        <mxCell id="jwt-okta-cfg" value="&lt;b&gt;Okta Authorization Server Setup&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;Custom Scopes:&lt;/b&gt;&lt;br&gt;  mcp:fred:read, mcp:fred:search&lt;br&gt;  mcp:jira:read, mcp:jira:write&lt;br&gt;  mcp:confluence:read&lt;br&gt;  mcp:github:read, mcp:github:write&lt;br&gt;&lt;br&gt;&lt;b&gt;Access Policies:&lt;/b&gt;&lt;br&gt;  • mcp-desktop-policy: Auth Code + PKCE&lt;br&gt;    → Requires MFA, 15min token TTL&lt;br&gt;  • mcp-m2m-policy: Client Credentials&lt;br&gt;    → 1hr token TTL, no MFA required&lt;br&gt;&lt;br&gt;&lt;b&gt;Claim Mappings:&lt;/b&gt;&lt;br&gt;  • groups → Okta groups (mcp-admins, etc.)&lt;br&gt;  • scp → requested scopes&lt;br&gt;  • cid → Okta client ID&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF8E1;strokeColor=#F57F17;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="490" y="660" width="430" height="280" as="geometry" />
        </mxCell>

        <!-- ================================================================ -->
        <!-- SECURITY LAYERS -->
        <!-- ================================================================ -->

        <mxCell id="sec-layers" value="&lt;b&gt;Defense-in-Depth Security Layers&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#FFEBEE;strokeColor=#C62828;verticalAlign=top;align=left;spacingLeft=15;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="980" y="610" width="980" height="350" as="geometry" />
        </mxCell>

        <mxCell id="sec-l1" value="&lt;b&gt;L1 — Perimeter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• Shield Advanced (DDoS)&lt;br&gt;• WAF v2 (OWASP, rate limit)&lt;br&gt;• GovCloud isolation&lt;br&gt;• TLS 1.3 (FIPS ciphers)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFCDD2;strokeColor=#E53935;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="1000" y="660" width="200" height="110" as="geometry" />
        </mxCell>

        <mxCell id="sec-l2" value="&lt;b&gt;L2 — Authentication&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• Okta OIDC (not Cognito)&lt;br&gt;• Client Credentials (M2M)&lt;br&gt;• Auth Code + PKCE (users)&lt;br&gt;• Adaptive MFA (Okta Verify)&lt;br&gt;• No long-lived API keys&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#C8E6C9;strokeColor=#43A047;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="1220" y="660" width="200" height="110" as="geometry" />
        </mxCell>

        <mxCell id="sec-l3" value="&lt;b&gt;L3 — Authorization&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• JWT scope enforcement&lt;br&gt;• Okta groups → RBAC&lt;br&gt;• Per-target IAM Task Roles&lt;br&gt;• Gateway AllowedClients&lt;br&gt;• SCPs (org guardrails)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#BBDEFB;strokeColor=#1976D2;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="1440" y="660" width="200" height="110" as="geometry" />
        </mxCell>

        <mxCell id="sec-l4" value="&lt;b&gt;L4 — Network&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• Private subnets (ECS)&lt;br&gt;• PrivateLink (cross-acct)&lt;br&gt;• Transit GW (on-prem)&lt;br&gt;• SG references (no CIDR)&lt;br&gt;• NAT GW (outbound only)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFE0B2;strokeColor=#F57C00;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="1660" y="660" width="200" height="110" as="geometry" />
        </mxCell>

        <mxCell id="sec-l5" value="&lt;b&gt;L5 — Data Protection&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• KMS CMK (FIPS 140-2 L3)&lt;br&gt;• Secrets auto-rotation (30d)&lt;br&gt;• No secrets in env/code&lt;br&gt;• Container image signing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#E1BEE7;strokeColor=#8E24AA;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="1000" y="800" width="200" height="110" as="geometry" />
        </mxCell>

        <mxCell id="sec-l6" value="&lt;b&gt;L6 — Observability&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• CloudTrail (365d)&lt;br&gt;• VPC Flow Logs (90d)&lt;br&gt;• GuardDuty (ECS runtime)&lt;br&gt;• Security Hub (NIST 800-53)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#E1BEE7;strokeColor=#8E24AA;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="1220" y="800" width="200" height="110" as="geometry" />
        </mxCell>

        <mxCell id="sec-l7" value="&lt;b&gt;L7 — AgentCore Guardrails&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• Content filtering (PII/PHI)&lt;br&gt;• Topic restrictions&lt;br&gt;• Governance policies (DDB)&lt;br&gt;• Audit log (all decisions)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFE0B2;strokeColor=#F57C00;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="1440" y="800" width="200" height="110" as="geometry" />
        </mxCell>

        <!-- ================================================================ -->
        <!-- COMPARISON TABLE -->
        <!-- ================================================================ -->

        <mxCell id="comparison" value="&lt;b&gt;Architecture Comparison: v1 (Cognito) vs v2 (Okta + AgentCore)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;table border=&quot;1&quot; cellpadding=&quot;5&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse:collapse;width:100%&quot;&gt;&lt;tr style=&quot;background:#E0E0E0&quot;&gt;&lt;th align=&quot;left&quot;&gt;Component&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;v1 (Previous)&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;v2 (AgentCore + Okta)&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Identity Provider&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Amazon Cognito&lt;/td&gt;&lt;td&gt;Okta (OIDC / OAuth 2.0)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;MCP Gateway&lt;/b&gt;&lt;/td&gt;&lt;td&gt;API Gateway + ALB path routing&lt;/td&gt;&lt;td&gt;AgentCore Gateway (native MCP)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Auth Mechanism&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Cognito JWT + mTLS&lt;/td&gt;&lt;td&gt;Okta JWT (CUSTOM_JWT authorizer)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;MFA&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Cognito TOTP&lt;/td&gt;&lt;td&gt;Okta Verify (Push + TOTP + FIDO2)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Target Routing&lt;/b&gt;&lt;/td&gt;&lt;td&gt;ALB listener rules (/fred/*)&lt;/td&gt;&lt;td&gt;GatewayTarget resources&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Memory&lt;/b&gt;&lt;/td&gt;&lt;td&gt;None&lt;/td&gt;&lt;td&gt;AgentCore Memory (episodic/semantic)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Content Safety&lt;/b&gt;&lt;/td&gt;&lt;td&gt;None&lt;/td&gt;&lt;td&gt;AgentCore Guardrails (PII, topics)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Agent Hosting&lt;/b&gt;&lt;/td&gt;&lt;td&gt;ECS Fargate (self-managed)&lt;/td&gt;&lt;td&gt;AgentCore Runtime + ECS Fargate&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FAFAFA;strokeColor=#333;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;spacingRight=10;overflow=auto;" vertex="1" parent="1">
