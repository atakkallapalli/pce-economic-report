        <mxCell id="legend-title" value="&lt;b&gt;Key Architecture Differences (v2 vs v1)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontStyle=1;" vertex="1" parent="1">
