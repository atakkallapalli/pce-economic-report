          <mxGeometry x="250" y="720" width="900" height="750" as="geometry" />
        </mxCell>
        <mxCell id="ec2-label" value="&lt;b&gt;Amazon EC2 Instance&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#555&quot;&gt;t3.large | Amazon Linux 2023 | Private IP only&lt;br&gt;Instance Profile: mcp-ec2-role | IMDSv2 enforced | EBS encrypted (KMS)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontStyle=1;" vertex="1" parent="1">
