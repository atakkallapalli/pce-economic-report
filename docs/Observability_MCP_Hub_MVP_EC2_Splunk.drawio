        <mxCell id="splunk-label" value="&lt;b&gt;Splunk Enterprise&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#555&quot;&gt;Deployed in same VPC / Private Subnet | Port: 8089 (REST API) + 8088 (HEC)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontStyle=1;" vertex="1" parent="1">
