          <mxGeometry x="230" y="510" width="150" height="50" as="geometry" />
        </mxCell>

        <mxCell id="sg-ec2" value="&lt;b&gt;SG: mcp-ec2-sg&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Inbound: 80 from ALB SG only&lt;br&gt;Outbound: 8089 → Splunk SG&lt;br&gt;Outbound: 443 → VPC Endpoints&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=#147EBA;fillColor=#E6F2F8;fontSize=9;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="230" y="1420" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="sg-splunk" value="&lt;b&gt;SG: splunk-sg&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Inbound: 8089 from EC2 SG only&lt;br&gt;Outbound: 443 (updates)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=#37474F;fillColor=#ECEFF1;fontSize=9;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1700" y="1250" width="190" height="50" as="geometry" />
        </mxCell>

        <!-- ════════════════════════════════════════════════════════════════ -->
        <!-- DATA FLOW ARROWS (NUMBERED) -->
        <!-- ════════════════════════════════════════════════════════════════ -->

        <!-- ① User → ALB -->
        <mxCell id="flow-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#1565C0;strokeWidth=3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="475" y="155" as="sourcePoint" /><mxPoint x="475" y="290" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="flow-1-l" value="&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;①&lt;/b&gt; HTTPS :443&lt;br&gt;TLS 1.3 + Okta JWT&lt;/font&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#1565C0;fillColor=#FFFFFF;strokeColor=#1565C0;rounded=1;" vertex="1" connectable="0" parent="flow-1">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- ② ALB → EC2 (Nginx) -->
        <mxCell id="flow-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#1565C0;strokeWidth=3;" edge="1" source="alb" target="nginx" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow-2-l" value="&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;②&lt;/b&gt; HTTP :80&lt;br&gt;(internal, SG-restricted)&lt;/font&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#1565C0;fillColor=#FFFFFF;strokeColor=#1565C0;rounded=1;" vertex="1" connectable="0" parent="flow-2">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- ③ Chat UI → Agent Backend -->
        <mxCell id="flow-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#E65100;strokeWidth=2;" edge="1" source="chat-ui" target="agent-backend" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow-3-l" value="&lt;font style=&quot;font-size:9px&quot;&gt;&lt;b&gt;③&lt;/b&gt; POST /api/query&lt;br&gt;{user_message, session_id}&lt;br&gt;+ Okta JWT in cookie&lt;/font&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#E65100;fillColor=#FFFFFF;strokeColor=#E65100;rounded=1;" vertex="1" connectable="0" parent="flow-3">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- ④ Agent → Bedrock -->
        <mxCell id="flow-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#01A88D;strokeWidth=2;" edge="1" source="agent-backend" target="bedrock" parent="1">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="450" y="1250" /><mxPoint x="1250" y="1250" /><mxPoint x="1250" y="460" /><mxPoint x="1600" y="460" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="flow-4-l" value="&lt;font style=&quot;font-size:9px&quot;&gt;&lt;b&gt;④&lt;/b&gt; InvokeModel (IAM SigV4)&lt;br&gt;NL → tool_call generation&lt;/font&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#01A88D;fillColor=#FFFFFF;strokeColor=#01A88D;rounded=1;" vertex="1" connectable="0" parent="flow-4">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- ⑤ Agent → MCP Server -->
        <mxCell id="flow-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2E7D32;strokeWidth=3;" edge="1" source="agent-backend" target="mcp-server" parent="1">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="600" y="1140" /><mxPoint x="600" y="930" /><mxPoint x="700" y="930" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="flow-5-l" value="&lt;font style=&quot;font-size:9px&quot;&gt;&lt;b&gt;⑤&lt;/b&gt; MCP tool_call (JSON-RPC)&lt;br&gt;localhost:3001/mcp&lt;br&gt;{method: &quot;tools/call&quot;,&lt;br&gt; params: {name: &quot;splunk_search&quot;, ...}}&lt;/font&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#2E7D32;fillColor=#FFFFFF;strokeColor=#2E7D32;rounded=1;" vertex="1" connectable="0" parent="flow-5">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- ⑥ MCP Server → Secrets Manager -->
        <mxCell id="flow-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#DD344C;strokeWidth=2;dashed=1;" edge="1" source="mcp-server" target="secrets-mgr" parent="1">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="850" y="790" /><mxPoint x="850" y="265" /><mxPoint x="1350" y="265" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="flow-6-l" value="&lt;font style=&quot;font-size:9px&quot;&gt;&lt;b&gt;⑥&lt;/b&gt; GetSecretValue&lt;br&gt;(IAM Instance Profile)&lt;br&gt;cached 5 min&lt;/font&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#DD344C;fillColor=#FFFFFF;strokeColor=#DD344C;rounded=1;" vertex="1" connectable="0" parent="flow-6">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- ⑦ MCP Server → Splunk REST API -->
        <mxCell id="flow-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#37474F;strokeWidth=3;" edge="1" source="mcp-server" target="splunk-rest" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow-7-l" value="&lt;font style=&quot;font-size:9px&quot;&gt;&lt;b&gt;⑦&lt;/b&gt; HTTPS :8089&lt;br&gt;Authorization: Bearer &lt;token&gt;&lt;br&gt;POST /services/search/jobs&lt;br&gt;(SG: EC2→Splunk only)&lt;/font&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#37474F;fillColor=#FFFFFF;strokeColor=#37474F;rounded=1;" vertex="1" connectable="0" parent="flow-7">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- ⑧ Response back -->
        <mxCell id="flow-8" value="&lt;font style=&quot;font-size:9px&quot;&gt;&lt;b&gt;⑧&lt;/b&gt; tool_result JSON&lt;br&gt;(reverse path: Splunk → MCP → Agent → UI → User)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=#1565C0;fillColor=#E3F2FD;fontSize=9;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="550" y="1420" width="310" height="40" as="geometry" />
        </mxCell>

        <!-- Okta Auth Flow (dashed) -->
        <mxCell id="flow-okta" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#1A237E;strokeWidth=1;dashed=1;" edge="1" source="chat-ui" target="okta" parent="1">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="260" y="900" /><mxPoint x="260" y="200" /><mxPoint x="1190" y="200" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="flow-okta-l" value="&lt;font style=&quot;font-size:8px&quot;&gt;Login: OIDC&lt;br&gt;Auth Code + PKCE&lt;br&gt;+ MFA&lt;/font&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#1A237E;" vertex="1" connectable="0" parent="flow-okta">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- ════════════════════════════════════════════════════════════════ -->
        <!-- LEGEND -->
        <!-- ════════════════════════════════════════════════════════════════ -->

        <mxCell id="legend-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="120" y="1580" width="2170" height="230" as="geometry" />
        </mxCell>

        <mxCell id="legend-title" value="&lt;b&gt;Legend — Request Flow &amp; Security&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="140" y="1590" width="240" height="25" as="geometry" />
        </mxCell>

        <!-- Flow Steps -->
        <mxCell id="leg-flow" value="&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;Request Flow:&lt;/b&gt;&lt;br&gt;&lt;b&gt;①&lt;/b&gt; User browser → ALB (HTTPS/TLS 1.3, Okta JWT in header)&lt;br&gt;&lt;b&gt;②&lt;/b&gt; ALB → EC2 Nginx (HTTP :80, internal only, SG-restricted)&lt;br&gt;&lt;b&gt;③&lt;/b&gt; Chat UI → Agent Backend (POST /api/query + session JWT)&lt;br&gt;&lt;b&gt;④&lt;/b&gt; Agent → Bedrock (IAM SigV4 via VPC Endpoint, NL → tool_call)&lt;br&gt;&lt;b&gt;⑤&lt;/b&gt; Agent → MCP Server (JSON-RPC localhost:3001, tools/call)&lt;br&gt;&lt;b&gt;⑥&lt;/b&gt; MCP Server → Secrets Manager (IAM Instance Profile, cached)&lt;br&gt;&lt;b&gt;⑦&lt;/b&gt; MCP Server → Splunk REST API (HTTPS :8089, Bearer token, SG-restricted)&lt;br&gt;&lt;b&gt;⑧&lt;/b&gt; Response: Splunk → MCP → Agent → Chat UI → User (reverse path)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="140" y="1620" width="560" height="165" as="geometry" />
        </mxCell>

        <!-- Security Details -->
        <mxCell id="leg-security" value="&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;Security Controls:&lt;/b&gt;&lt;br&gt;&lt;b&gt;Authentication:&lt;/b&gt; Okta OIDC (Auth Code + PKCE + MFA) → JWT (RS256, 15min TTL)&lt;br&gt;&lt;b&gt;Authorization:&lt;/b&gt; JWT scopes (mcp:splunk:read) validated at Agent Backend&lt;br&gt;&lt;b&gt;IAM:&lt;/b&gt; EC2 Instance Profile (least-privilege: Secrets, Bedrock, CW only)&lt;br&gt;&lt;b&gt;Encryption Transit:&lt;/b&gt; TLS 1.3 (ALB↔User), HTTPS (EC2↔Splunk :8089)&lt;br&gt;&lt;b&gt;Encryption Rest:&lt;/b&gt; KMS CMK (EBS, Secrets Manager, CloudWatch Logs)&lt;br&gt;&lt;b&gt;Network:&lt;/b&gt; Private subnet (no public IP on EC2), SG references (not CIDR)&lt;br&gt;&lt;b&gt;Secrets:&lt;/b&gt; Splunk token in Secrets Manager, 30-day rotation, never in env vars&lt;br&gt;&lt;b&gt;Audit:&lt;/b&gt; CloudTrail (all API calls) + CloudWatch Logs (app logs, 90-day retention)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="750" y="1620" width="560" height="175" as="geometry" />
        </mxCell>

        <!-- Color Legend -->
        <mxCell id="leg-colors" value="&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;Color Key:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1565C0&quot;&gt;━━ Blue: User/HTTP data flow&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;━━ Green: MCP protocol (JSON-RPC)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#E65100&quot;&gt;━━ Orange: Internal API calls&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#01A88D&quot;&gt;━━ Teal: Bedrock LLM invocation&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DD344C&quot;&gt;- - Red dashed: Secrets/security&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#37474F&quot;&gt;━━ Dark: Splunk vendor API&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1A237E&quot;&gt;- - Navy dashed: Auth (Okta OIDC)&lt;/font&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1380" y="1620" width="240" height="155" as="geometry" />
        </mxCell>

        <!-- Architecture Note -->
        <mxCell id="leg-note" value="&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;MVP Scope:&lt;/b&gt;&lt;br&gt;• Single EC2 (Chat UI + MCP Server)&lt;br&gt;• Single Splunk MCP Server only&lt;br&gt;• No AgentCore, no Cognito&lt;br&gt;• Okta IdP + AWS IAM only&lt;br&gt;• Network (TGW/VPN) excluded&lt;br&gt;• All in same GovCloud account&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1680" y="1620" width="240" height="140" as="geometry" />
        </mxCell>

        <!-- User Icon (top) -->
        <mxCell id="user-icon" value="&lt;b&gt;SRE / Engineer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Browser (HTTPS)&lt;/font&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="400" y="85" width="150" height="70" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
