          <mxGeometry x="1100" y="725" width="40" height="40" as="geometry" />
        </mxCell>

        <!-- Chat UI (Web App) -->
        <mxCell id="chat-ui" value="&lt;b&gt;Chat UI (Web Application)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;React/Next.js SPA&lt;br&gt;Port: 3000 (Nginx reverse proxy)&lt;br&gt;Okta OIDC Login (PKCE)&lt;br&gt;Session: HTTP-only Secure Cookie&lt;br&gt;CSP Headers enforced&lt;br&gt;User sends natural language queries&lt;br&gt;Renders MCP tool_result responses&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=10;verticalAlign=top;align=center;shadow=1;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="310" y="810" width="280" height="180" as="geometry" />
        </mxCell>

        <!-- LLM / Agent Backend -->
        <mxCell id="agent-backend" value="&lt;b&gt;Agent Backend (Python)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Strands SDK / LangChain&lt;br&gt;Port: 8000 (FastAPI)&lt;br&gt;Receives user query from Chat UI&lt;br&gt;Calls Amazon Bedrock (Claude)&lt;br&gt;for intent → MCP tool_call&lt;br&gt;Invokes MCP Server locally&lt;br&gt;Returns formatted response&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=10;verticalAlign=top;align=center;shadow=1;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="310" y="1050" width="280" height="180" as="geometry" />
        </mxCell>

        <!-- MCP Server -->
        <mxCell id="mcp-server" value="&lt;b&gt;Splunk MCP Server&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;MCP SDK (TypeScript/Python)&lt;br&gt;Port: 3001 (HTTP Streamable)&lt;br&gt;Protocol: JSON-RPC 2.0&lt;br&gt;Tools:&lt;br&gt;  • splunk_search (SPL queries)&lt;br&gt;  • splunk_get_alerts&lt;br&gt;  • splunk_list_indexes&lt;br&gt;  • splunk_saved_searches&lt;br&gt;Credentials: from Secrets Manager&lt;br&gt;Input validation: JSON Schema&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=10;verticalAlign=top;align=center;shadow=1;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="700" y="810" width="300" height="230" as="geometry" />
        </mxCell>

        <!-- Observability Agent (CloudWatch) -->
        <mxCell id="cw-agent" value="&lt;b&gt;CloudWatch Agent&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Logs + Metrics&lt;br&gt;X-Ray Daemon&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;fontSize=9;shadow=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="700" y="1100" width="130" height="70" as="geometry" />
        </mxCell>

        <!-- Nginx -->
        <mxCell id="nginx" value="&lt;b&gt;Nginx&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Reverse Proxy&lt;br&gt;:80/:443 → :3000 (UI)&lt;br&gt;/api/* → :8000 (Agent)&lt;br&gt;/mcp/* → :3001 (MCP)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#455A64;fontSize=9;shadow=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="310" y="1290" width="200" height="100" as="geometry" />
        </mxCell>

        <!-- ──────────────────────────────────────────── -->
        <!-- SPLUNK ENTERPRISE -->
        <!-- ──────────────────────────────────────────── -->

